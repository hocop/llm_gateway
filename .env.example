# Secrets of the virtual keys: LLM_KEY_<NAME> for the key named <name> in config/virtual_keys.toml.
# The names below match examples/config/virtual_keys.toml; change them to your own keys.
#
# Copy this file to .env and replace every value: the secrets must differ from each other, and the
# gateway refuses to start if two keys share one. `uv run scripts/generate_keys.py` fills in the
# keys that have no secret yet. Any non-empty secret works; sk-<uuid4> is just what it generates.

LLM_KEY_ME=sk-6c6b418e-4d41-4d93-86ad-eeb419c80a01
LLM_KEY_MY_FRIEND=sk-1f2a7b34-9c4e-4a17-b2d5-3e8f10c6d702
LLM_KEY_MY_SERVICE_1=sk-c83d5e20-7b61-4f8a-9e34-5a1d92fb4c03
